pipeline {
    agent { label 'testnode' }
    
    parameters {
        booleanParam(name: 'CODEANALYSIS', defaultValue: true, description: 'Run code coverage analysis')
    }
    
    environment {
        M2_HOME = '/usr/local/maven'
        PATH = "${env.M2_HOME}/bin:${env.PATH}"
    }
    
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        
        stage('Build') {
            steps {
                echo 'Hi this is for testing'
                sh 'mvn --version'
                sh 'mvn clean package'
            }
        }
        
        stage('Code Coverage') {
            steps {
                echo "Running Code Coverage..."
                sh "sh "mvn org.jacoco:jacoco-maven-plugin:prepare-agent""
            }
        }
    }
}
